# ===== Python / uv =====
# 虚拟环境（本地依赖，由 uv sync 重建）
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
# 测试 / 类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
# 打包元数据
*.egg-info/
.eggs/
# uv 本地产物
.python-version
# 内嵌 Python 运行时（本地下载 + 安装依赖，不入库；由 start-embed.ps1 使用）
/python-3.12.10-embed-amd64/

# ===== 前端 (Vue + Vite) =====
node_modules/
dist/
dist-ssr/
*.local
# Vite / 构建缓存
.vite/
.vite-cache/
# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== 运行时数据 / 日志 =====
*.log
logs/
# SQLite 数据库与运行时临时文件（运行期生成，不入库；首次部署由 scripts/init_db.py 初始化）
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.db-journal
# 用户上传文件目录（运行时生成，保留空目录结构）
!backend/data/files/

# ===== 敏感配置 =====
.env
.env.*
!.env.example
# 一键启动脚本（start-embed.ps1）首次运行生成的本地开发密钥
backend/data/.dev-secrets.env
# 密钥 / 证书
*.pem
*.key
*.p12
*.crt

# ===== 系统 / 编辑器杂项 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Claude Code 本地配置 =====
.claude/settings.local.json

# ===== Docker 部署 =====
# 仓库内 compose 部署时生成的运行时数据（docker-compose.yml 卷挂载 ./data）
/data/

# ===== 顶层非项目资料（与代码无关的复习文档）=====
/基础班知识总结与复习资料.docx
/基础班知识总结与复习资料.xlsx
