# QuizHub 容器部署配置：cp .env.example .env 后按需修改（.env 已被 git 忽略）

# [必填] JWT 签名密钥
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TRAINING_SECRET_KEY=

# [可选] 敏感设置（SMTP 密码）的 Fernet 加密密钥，32 字节 url-safe base64
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRAINING_ENC_KEY=

# [可选] 初始超管账号（仅首次建库时生效）
# 不设置密码时，首次启动会在容器日志中输出一次性随机密码
TRAINING_SUPER_ADMIN_EMAIL=admin@example.com
TRAINING_SUPER_ADMIN_PASSWORD=

# [可选] 宿主机映射端口（默认 8000）
HTTP_PORT=8000

# [可选] 反向代理（Nginx/Caddy）后设为 true，从 X-Forwarded-For 取真实客户端 IP；
# 容器端口直接暴露时保持 false，避免转发头伪造绕过限流
TRAINING_TRUST_PROXY=false

# [可选] 业务时区（IANA 名称），决定统计中「今日」的归属边界与排行/面板的日期口径。
# 默认 Asia/Shanghai；非该时区部署请显式设置，否则「今日活跃」等指标会按 +8 归属。
TRAINING_TZ=Asia/Shanghai

# [可选] 允许的跨域来源，逗号分隔；前后端同源部署保持默认
TRAINING_CORS_ORIGINS=*
